# PeopleOS environment — template. Copy to .env.local (the authoritative local list).
# Sensitive = anything obtained by logging into an account -> value MUST be the
# literal marker `keyring`; the real value lives in KWallet (wallet kdewallet,
# folder PEOPLEOS, entry = this exact variable name). Non-sensitive settings
# carry real values here. NEVER put a real secret in any file.

# --- Supabase (account-derived) ---
NEXT_PUBLIC_SUPABASE_URL=keyring
NEXT_PUBLIC_SUPABASE_ANON_KEY=keyring
SUPABASE_SERVICE_ROLE_KEY=keyring

# --- Twilio (account-derived) ---
TWILIO_ACCOUNT_SID=keyring
TWILIO_AUTH_TOKEN=keyring
TWILIO_PHONE_NUMBER=keyring
TWILIO_MESSAGING_SERVICE_SID=keyring

# --- Microsoft (account-derived) ---
MICROSOFT_CLIENT_ID=keyring
MICROSOFT_TENANT_ID=keyring
MICROSOFT_CLIENT_SECRET=keyring

# --- Payroll (account-derived) ---
PAYROLL_PROVIDER_SECRET=keyring

# --- Our own settings (no account required) ---
TWILIO_WEBHOOK_BASE_URL=
PEOPLEOS_PLATFORM_ADMIN_EMAILS=
